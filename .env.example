# CDP SDK credentials (from https://portal.cdp.coinbase.com)
CDP_API_KEY_ID=your-key-id-here
CDP_API_KEY_SECRET=your-private-key-here
CDP_WALLET_SECRET=your-wallet-secret-here

# Alchemy RPC for Base (free tier)
ALCHEMY_BASE_RPC=https://base-mainnet.g.alchemy.com/v2/your-alchemy-key

# Optional: Telegram bot for alerts
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# Optional: Wallet address to monitor (if already created)
WALLET_ADDRESS=
