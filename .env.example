# Environment variables for Base Micro-Arb Bot
# Copy this file to .env and fill in your credentials
# NEVER commit .env to git (it's in .gitignore)

# === CDP SDK (Coinbase Developer Platform) ===
# Get free at https://portal.cdp.coinbase.com
# Used for creating non-custodial wallets via Coinbase infrastructure
CDP_API_KEY_ID=your-key-id-here
CDP_API_KEY_SECRET=your-private-key-here
CDP_WALLET_SECRET=your-wallet-secret-here

# === Pimlico (for Smart Account) ===
# Get free at https://dashboard.pimlico.io
# Required for deploying contracts via Smart Account (account abstraction)
PIMLICO_API_KEY=your-pimlico-key-here

# === Smart Account Owner (CRITICAL — keep secret) ===
# The EOA private key that controls Smart Account 0x53dbe1b36BA3BEAC6cEf6cD22AD50E362DBcB23A
# Get from your wallet (MetaMask: Account Details > Export Private Key)
SMART_ACCOUNT_OWNER_PRIVATE_KEY=0x...

# === RPC ===
# Alchemy Base mainnet RPC (free tier works)
ALCHEMY_BASE_RPC=https://base-mainnet.g.alchemy.com/v2/alch_BUo0TYqkD24rLEzrz4U3n

# === Optional: Telegram alerts ===
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# === Optional: Wallet to monitor (already set) ===
WALLET_ADDRESS=0x53dbe1b36BA3BEAC6cEf6cD22AD50E362DBcB23A
